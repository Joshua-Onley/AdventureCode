# Stores development environment variables

# Database (connects to postgres container)
DATABASE_URL=postgresql://adventurecode_user:dev_password_123@postgres:5432/adventurecode_dev

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

# CORS - Must be JSON array format
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:8000","http://frontend:5173"]

# Piston API
PISTON_URL=https://emkc.org/api/v2/piston/execute